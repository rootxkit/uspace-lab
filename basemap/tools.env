# WP-L3 tool pins, sourced by build.sh, verify.sh, tools.sh and the
# release workflow. Change a pin here and nowhere else; SOURCE.json
# records the versions the build actually ran.

# github.com/protomaps/go-pmtiles: extract and merge (installed with
# `go install`, verified by the Go checksum database).
GO_PMTILES_VERSION=v1.31.2

# github.com/protomaps/font-maker: glyph PBFs from TTFs (the tool
# basemaps-assets' fonts are made with). No releases; pinned by commit,
# its submodules by the commits that commit records.
FONT_MAKER_REPO=https://github.com/protomaps/font-maker.git
FONT_MAKER_COMMIT=714ccaea67d384717890a3c2c27143dfdd4189b7

# Caddy, the file server the deployment serves /basemap/ with (M38);
# verify.sh asks it for a byte range when no caddy binary is on PATH.
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
