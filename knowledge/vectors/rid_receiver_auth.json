    "authority"
   ],
   "input": {
    "key_hex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
    "report_utf8": "{\"receiver_id\": \"rx-1\", \"transmitter\": \"AA:BB:CC:00:00:01\", \"payload_hex\": \"00\", \"sent_at_ms\": 1790000000000, \"nonce\": \"n-1\"}"
   },
   "expected": {
    "datagram_utf8": "{\"receiver_id\": \"rx-1\", \"transmitter\": \"AA:BB:CC:00:00:01\", \"payload_hex\": \"00\", \"sent_at_ms\": 1790000000000, \"nonce\": \"n-1\"}\nsig=8552d45fba4475805af3d579ece6f23f68cf2c8aac7273590850984f60caf7d1",
    "signature_hex": "8552d45fba4475805af3d579ece6f23f68cf2c8aac7273590850984f60caf7d1"
   },
   "why": "The signature covers the exact report bytes: no JSON canonicalisation, so an ESP32 can sign with its SDK HMAC. Datagram = report + '\\nsig=' + hex."
  },
