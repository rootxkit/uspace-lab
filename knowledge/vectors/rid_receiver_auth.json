{
 "description": "Authenticating Remote ID receivers (P1-15). The broadcast can never be authenticated; the receiver that says it heard it can. HMAC-SHA256 per receiver key, a +-30 s window on sent_at_ms and a per-receiver nonce. Error texts are the old ones; match on accepted.",
 "source": [
  "utm gateway/tests/test_remote_id_auth.py",
  "utm gateway/remote_id_auth.py"
 ],
 "units": {
  "now_s": "epoch seconds on the ingest's clock",
  "sent_at_ms": "epoch milliseconds, receiver's clock"
 },
 "tolerance": {
  "accepted": "exact",
  "signature_hex": "exact"
 },
 "owners": [
  "authority"
 ],
 "generated": "Expected values computed by knowledge/tools/gen_vectors.py, which runs the old Python implementation (rootxkit/utm @ 484cd228035f) on these inputs. Regenerate rather than edit.",
 "utm_commit": "484cd228035f2f424530e233ce72100d0fc1842a",
 "cases": [
