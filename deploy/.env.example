# deploy/.env for the lab stack (deploy/compose.yaml). `make dss-up`
# copies this file to deploy/.env (git-ignored) when there is none. Every
# variable the compose file reads is here. No secret goes in this file:
# keys and client secrets are generated at run time into LAB_STATE_DIR.

# ---- DSS (profile dss) -------------------------------------------------

# The DSS's public host: accepted as a JWT audience beside the compose
# service name `dss` (decision record M18). On the droplet, the host
# Caddy serves the DSS on.
DSS_PUBLIC_HOST=dss.localhost
# The DSS's own public base URL (core-service -public_endpoint), stored
# in its aux metadata.
DSS_PUBLIC_ENDPOINT=http://dss:8082
# Self-identification of this DSS instance (core-service -locality).
DSS_LOCALITY=uspace_lab
# Accept http:// uss_base_url values (core-service -allow_http_base_urls):
# true in the lab, where the peers are compose services without TLS;
# false wherever the peers are behind TLS.
DSS_ALLOW_HTTP_BASE_URLS=true
# CockroachDB memory pools (--cache, --max-sql-memory). The measured
# footprint with these values is in deploy/README.md.
CRDB_CACHE=64MiB
CRDB_MAX_SQL_MEMORY=128MiB

# ---- Lab issuer (profile issuer) ---------------------------------------

# The iss claim of every token, and the issuer the verifiers allow-list.
LAB_ISSUER_URL=http://lab-issuer:8080
# Token lifetime; at most 1h (the DSS refuses exp more than an hour
# ahead, so a little margin keeps a slightly fast issuer clock harmless).
LAB_ISSUER_TOKEN_TTL=50m
# Hosts each system is reached at, comma-separated: its public host and
# its lab alias (the compose service name). National scopes are issued
# only for these audiences (deploy/issuer/clients.yaml).
LAB_AUTHORITY_AUDIENCES=authority
LAB_CISP_AUDIENCES=cisp
LAB_ANSP_AUDIENCES=ansp
LAB_USSP_AUDIENCES=ussp
# Git-ignored directory for the generated signing key, the client secrets
# and the public key outputs (public/issuer-public.pem, public/jwks.json),
# relative to deploy/.
LAB_STATE_DIR=./local
# Image of the lab issuer; built from this repository when absent.
LAB_ISSUER_IMAGE=uspace-lab/lab-issuer:local

# ---- make dss-up proof (lab-issuer probe) ------------------------------

# The DSS as the probe reaches it; its host is the token audience.
DSS_URL=http://dss:8082
# The search area: a circle and a WGS84 altitude band, searched from now
# for DSS_PROBE_WINDOW. Any area works; it should hold no intents.
DSS_PROBE_LAT_DEG=41.7151
DSS_PROBE_LNG_DEG=44.8271
DSS_PROBE_RADIUS_M=500
DSS_PROBE_ALT_LOWER_WGS84_M=0
DSS_PROBE_ALT_UPPER_WGS84_M=1500
DSS_PROBE_WINDOW=10m
# An audience the DSS must refuse (the third proof).
DSS_PROBE_WRONG_AUDIENCE=not-the-dss.invalid

# ---- Peer USSP (profile sim, make sim-ussp-up) -------------------------

# Image of the peer USSP; built from this repository when absent.
LAB_SIM_USSP_IMAGE=uspace-lab/sim-ussp:local
# The Identification Service Area it writes to the DSS:
# lat_deg,lon_deg,radius_m,alt_lower_wgs84_m,alt_upper_wgs84_m, from now
# for an hour.
SIM_USSP_ISA=41.7300,44.8500,2000,500,900
# One operational intent reference it writes (same five numbers, from
# now for an hour). Kept inside the ISA and away from the
# DSS_PROBE_* area, which the dss-up proof expects to be empty.
SIM_USSP_INTENT=41.7300,44.8500,300,600,760
