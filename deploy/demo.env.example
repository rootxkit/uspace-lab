# deploy/demo.env for the whole lab stack (make demo, docs/RUNBOOKS/
# demo.md): the WP-L2 compose (DSS, issuer) and the systems profile
# (deploy/systems/compose.yaml) as one project, uspace-demo. `make demo`
# copies this file to deploy/demo.env (git-ignored) when there is none.
# No secret is here: deploy/systems/gen-secrets.sh writes every key and
# password into DEMO_STATE_DIR, and deploy/demo-up.sh passes the
# generated passwords file as a second --env-file.
#
# The hosts are names under the reserved .test domain. Inside the stack
# they are network aliases of the lab Caddy, which terminates TLS with a
# certificate from the lab's own CA (gen-secrets.sh) and is published on
# 127.0.0.1:${DEMO_HTTPS_PORT}. Every system trusts that CA through
# SSL_CERT_FILE, so its HTTPS-only JWKS fetches work as on the droplet.
# Outside, the runner and the seed run under deploy/labns.sh, which gives
# them a private /etc/hosts naming the hosts 127.0.0.1 (nothing on the
# machine is changed).

# ---- hosts ---------------------------------------------------------------
AUTHORITY_HOST=authority.uspace.test
CISP_HOST=cisp.uspace.test
USSP_HOST=ussp.uspace.test
ANSP_HOST=ansp.uspace.test
# The DSS (/dss/*, /rid/*, /aux/*) and the lab issuer (/oauth/token,
# /.well-known/jwks.json) on one host, as uspace-deploy's LAB_HOST.
LAB_HOST=lab.uspace.test
DEMO_HTTPS_PORT=443
# The lab network's subnet, the range Docker hands addresses out from,
# and the lab Caddy's fixed address on it, outside that range: every
# system trusts X-Forwarded-For from that address only (*_TRUSTED_PROXIES),
# as on the droplet. Pick another /24 if Docker already uses this one.
DEMO_LAB_SUBNET=172.31.250.0/24
DEMO_LAB_IP_RANGE=172.31.250.0/25
DEMO_CADDY_IP=172.31.250.250
# The egress network's subnet and its gateway, the host's address on it:
# the published port's connections come from the gateway, and the lab
# Caddy and the authority trust X-Forwarded-For from it (the load
# harness gives each simulated receiver an address of its own).
DEMO_EGRESS_SUBNET=172.31.251.0/24
DEMO_HOST_GATEWAY=172.31.251.1
# The prefix the load harness gives its simulated receivers their own
# addresses from (loadgen seed writes it into the targets file; empty:
# they share the host's). Never a range the stack's networks use.
DEMO_LOAD_RECEIVER_ADDRESSES=10.77.0.0/16
# The same for its operator clients (their tokens, intents and sockets).
DEMO_LOAD_OPERATOR_ADDRESSES=10.78.0.0/16
# The load harness's own peer USSP (loadgen run; docs/RUNBOOKS/load.md
# "Systems mode"): the lab Caddy serves LOAD_PEER_HOST with the lab
# certificate and proxies it to the harness on the host, port
# DEMO_LOAD_PEER_PORT of host.docker.internal, so the authority's display
# provider and the USSP reach it as they reach any USS. Nothing answers
# there between runs (502).
LOAD_PEER_HOST=peer.uspace.test
DEMO_LOAD_PEER_PORT=18093

# ---- state ---------------------------------------------------------------
# Generated keys, passwords, the lab CA and the issuer's state; relative
# to deploy/, git-ignored.
DEMO_STATE_DIR=./local-demo
# The ground directory (geoid grid; terrain tiles when there are some),
# mounted read-only at /srv/ground in every system. The geoid is
# GeographicLib's egm2008-2_5.pgm (R-16: the same grid as targets.geoid).
DEMO_GROUND_DIR=./local-demo/ground

# ---- images ----------------------------------------------------------------
# By digest, each the image its system's CI published for the commit
# named (org.opencontainers.image.revision where the image carries it;
# the tag otherwise): the newest published at 2026-10-14. The compose
# files are uspace-deploy 8a242ec's (deploy/systems/SOURCE).
# authority 4a85d78 (tag sha-4a85d78)
AUTHORITY_IMAGE=ghcr.io/rootxkit/uspace-authority@sha256:53d6f97cd745677da893a62669f45477d1eaa403b369bc174b6ccc8c11ee11cc
# cisp 24659a5 (tag 24659a5; nothing newer is published)
CISP_GO_IMAGE=ghcr.io/rootxkit/uspace-cisp@sha256:2e7861488e178de967829e7ebb623a3c5b480f0dcca8e5ee1acab4e45028f42a
# ussp df23bf9 (tag df23bf9)
USSP_GO_IMAGE=ghcr.io/rootxkit/uspace-ussp@sha256:854cca7146277e6dc767cd7efce279f350994c9f152344a8af457c917db5935d
# ansp 3864302 (tag 3864302); published by its CI since 85436de, pulled by
# digest like the others. ANSP_SOURCE_COMMIT is what demo-up.sh builds
# from when ANSP_GO_IMAGE is a local name instead.
ANSP_GO_IMAGE=ghcr.io/rootxkit/uspace-ansp@sha256:1fcfb3c9762189f737250c65ad24166c025c12576abb7babffcf07d705a6921a
ANSP_SOURCE_COMMIT=3864302ae00df3a47e32f887d128458c76a0676a
TIMESCALEDB_IMAGE=timescale/timescaledb-ha:pg16@sha256:e9f34d8dd27621ec3933386eb07b70021d15b8116247362e0537bbff94ef0769
NATS_IMAGE=nats:2-alpine@sha256:ac8f88a6494bffc2c2a5289a0ca61cb28a9145c11ba5677cf24265d07f46d8d4
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

# ---- DSS and issuer (deploy/.env.example has the meaning of each) --------
DSS_PUBLIC_HOST=lab.uspace.test
DSS_PUBLIC_ENDPOINT=https://lab.uspace.test
DSS_LOCALITY=uspace_lab_demo
# The systems' uss_base_url are https behind the lab Caddy; the peer
# USSP (profile sim) is http.
DSS_ALLOW_HTTP_BASE_URLS=true
CRDB_CACHE=64MiB
CRDB_MAX_SQL_MEMORY=128MiB
LAB_ISSUER_URL=https://lab.uspace.test
LAB_ISSUER_TOKEN_TTL=50m
LAB_AUTHORITY_AUDIENCES=authority.uspace.test,authority
LAB_CISP_AUDIENCES=cisp.uspace.test,cisp
LAB_ANSP_AUDIENCES=ansp.uspace.test,ansp
LAB_USSP_AUDIENCES=ussp.uspace.test,ussp
LAB_STATE_DIR=./local-demo/issuer
LAB_ISSUER_IMAGE=uspace-lab/lab-issuer:local
DSS_URL=http://dss:8082
DSS_PROBE_LAT_DEG=41.7151
DSS_PROBE_LNG_DEG=44.8271
DSS_PROBE_RADIUS_M=500
DSS_PROBE_ALT_LOWER_WGS84_M=0
DSS_PROBE_ALT_UPPER_WGS84_M=1500
DSS_PROBE_WINDOW=10m
DSS_PROBE_WRONG_AUDIENCE=not-the-dss.invalid
LAB_SIM_USSP_IMAGE=uspace-lab/sim-ussp:local
SIM_USSP_ISA=41.7300,44.8500,2000,500,900
SIM_USSP_INTENT=41.7300,44.8500,300,600,760

# ---- the systems ---------------------------------------------------------
# The USSP code (M8) and its client id at the lab issuer: the USSP asks
# for tokens as "ussp-" + the code + "-01" (M24), the code's case kept
# (uspace-ussp 8cce0e0).
USSP_SYSTEM_ID=DEV01
USSP_CLIENT_ID=ussp-DEV01-01
# The country of every zone and restriction (ISO 3166-1 alpha-3).
DEMO_COUNTRY=GEO
# The bounding box the systems' CIS subscriptions cover:
# min_lng,min_lat,max_lng,max_lat (WGS84 degrees). Empty: everywhere.
DEMO_CIS_BBOX=
