# Copy to sim/sitl.env:  cp sim/sitl.env.example sim/sitl.env
#
# sim/sitl.env is gitignored. No script, scenario or simulator in this
# repository defaults a coordinate (docs/PLAN.md INV-03): run_sitl.sh
# refuses to start without SITL_HOME, and the scenario runner reads the
# same file so its synthetic vehicles start where the SITL ones do.

# Home of instance 0 and the origin every scenario offset is measured
# from: "lat,lon,alt_amsl_m,heading_deg". WGS84 decimal degrees, AMSL
# metres, degrees true. Set the altitude from the terrain at the point,
# not from a round number (the predecessor's 450 m was 155 m below the
# ground there; the Copernicus DEM gives 605 m at this point).
SITL_HOME=41.7151,44.8271,605,0

# Instance i starts SITL_SPACING_M * i metres due east of the home.
SITL_SPACING_M=25

# Instance i has SYSID SITL_SYSID_BASE + i. 0 is reserved, 255 is a GCS.
SITL_SYSID_BASE=1

# Instance i forwards its MAVLink to two local UDP ports, one per
# consumer, so the listener and the harness never share a socket:
#   SITL_OUT_PORT_BASE + i  sim/mav_reader.py, receive only
#   SITL_FLY_PORT_BASE + i  sim/fly.py, the harness (the only commander)
SITL_OUT_PORT_BASE=14560
SITL_FLY_PORT_BASE=14660

# An extra shared output for a ground station (QGC shows every vehicle on
# one link). Empty: none, which is what CI sets.
SITL_QGC_PORT=

# SITL instance numbers start here (sim_vehicle.py --instance K uses TCP
# 5760 + 10 K). Raise it to keep clear of another fleet on the machine;
# run_sitl.sh refuses to start on a port that is in use.
SITL_INSTANCE_BASE=0

# ArduPilot frame, simulation speed-up and the stream rate MAVProxy asks
# for (Hz).
SITL_FRAME=quad
SITL_SPEEDUP=1
SITL_STREAMRATE=4

# ArduPilot's sim_vehicle.py and MAVProxy. Unset: taken from PATH.
#SIM_VEHICLE=/home/you/ardupilot/Tools/autotest/sim_vehicle.py
#MAVPROXY=/home/you/ardupilot-venv/bin/mavproxy.py
